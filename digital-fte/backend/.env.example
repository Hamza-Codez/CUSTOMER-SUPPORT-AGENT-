# Everything below has a working default. Copy to .env and run — no edits needed.

# ============ Model provider: mock | openai | ollama ============
MODEL_PROVIDER=mock

# --- OpenAI (MODEL_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama, local & free (MODEL_PROVIDER=ollama) ---
# Requires: ollama pull llama3.1   (use a model that supports tool calling)
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Simulated token streaming for the mock model, in ms per word (0 = instant).
# Real providers ignore this — they stream as they infer.
MOCK_STREAM_DELAY_MS=18

# ============ Data backend: mock | supabase ============
# mock     = in-memory, zero setup, tickets vanish on restart
# supabase = Postgres + pgvector, tickets persist
DATA_BACKEND=mock

# --- Supabase (DATA_BACKEND=supabase) ---
# One-time setup, three commands:
#   python scripts/apply_schema.py      (creates every table — needs DB_URL below)
#   python scripts/ingest_kb.py         (embeds + loads db/knowledge/)
#   python scripts/verify_supabase.py   (proves the contracts hold)
# The SERVICE key is server-side only — never expose it to the browser.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=

# Direct Postgres connection — ONLY needed to create the schema.
# Supabase → Project Settings → Database → Connection string → URI.
# PostgREST (the service key) cannot run DDL, which is why this is separate.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Real auth (AUTH_PROVIDER=supabase): Settings → API → JWT Secret.
# Grant agents app_metadata.role = "agent"; user_metadata is ignored on purpose.
# SUPABASE_JWT_SECRET=

# ============ Embeddings (only used when DATA_BACKEND=supabase) ============
# mock   = deterministic lexical embedding, no API key, good enough to demo
# openai = real semantic retrieval (text-embedding-3-small, 1536 dims)
# ollama = local (nomic-embed-text is 768 dims — set EMBEDDING_DIM=768 AND
#          alter kb_docs.embedding to vector(768) before ingesting)
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=1536
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Changing EMBEDDING_PROVIDER means re-running scripts/ingest_kb.py: vectors
# from one model are not comparable to queries embedded by another.
