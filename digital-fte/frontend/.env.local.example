# Backend URL. Leave as-is for local dev; set to your Render URL on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth provider: mock | supabase   (default: mock)
# mock     = one-click demo sign-in, no account needed
# supabase = real email/password via Supabase Auth
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Only needed when NEXT_PUBLIC_AUTH_PROVIDER=supabase.
# The ANON key is safe in the browser; never put the SERVICE key here.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
