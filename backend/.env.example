# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Model provider -----------------------------------------------------------
# mock   = no API key needed; deterministic stub. The app boots and all tests pass.
# gemini = real Gemini via its OpenAI-compatible endpoint.
MODEL_PROVIDER=mock

GEMINI_API_KEY=
# Verified working 2026-07-26. Gemini model codes move fast: `gemini-2.5-flash`
# is still listed by the API but 404s with "no longer available to new users".
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Retrieval ----------------------------------------------------------------
# Independent of MODEL_PROVIDER. Gemini embeddings use a different quota bucket
# from chat, so retrieval can be real even when the chat model is rate-limited.
# Changing the provider or the dimension means re-running scripts/ingest_kb.py.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# --- Data ---------------------------------------------------------------------
# Leave empty to use the in-memory mock store (zero setup).
# Set to a real hosted Postgres URL to use the Postgres store.
#   postgresql://user:password@host:5432/dbname
#
# URL-ENCODE special characters in the password, or the URL misparses:
#   #->%23  /->%2F  *->%2A  @->%40  :->%3A  ?->%3F
# An unencoded '#' turns the rest into a URL fragment and you get
# "invalid literal for int() with base 10" from the port.
#
# Tables are created in an `fte` schema, never `public`, so this can safely be a
# database that already hosts other projects.
DATABASE_URL=

# --- Auth ---------------------------------------------------------------------
# Dev-only static tokens: "<token>:<business_id>:<role>", comma-separated.
# Phase 1 uses these instead of real JWT issuance (that arrives with the auth phase).
DEV_TOKENS=demo-token:biz_demo:customer,ops-token:biz_demo:operator

# --- Policy knobs (Phase 3 will enforce these; declared here so config is stable)
AUTO_REFUND_CAP=25.00
