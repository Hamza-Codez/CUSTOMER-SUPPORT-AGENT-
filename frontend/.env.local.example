# Where the FastAPI backend is reachable from the browser.
#
# Local:    http://localhost:8000
# Deployed: the API's own public URL, e.g.
#           https://customer-support-agent-a22h.vercel.app
#
# Read at build time, not at runtime — Next inlines NEXT_PUBLIC_* values into the
# bundle, so changing it on a deployed frontend needs a rebuild rather than a
# restart. No trailing slash: lib/api.ts concatenates paths onto it directly.
#
# The backend must also allow this frontend's origin: set ALLOWED_ORIGINS there,
# or every request fails CORS preflight with no useful error in the UI.
NEXT_PUBLIC_API_URL=http://localhost:8000
